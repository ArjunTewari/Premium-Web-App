modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["twilio:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 21680
externalPort = 3000

[userenv]

[userenv.shared]
SEED_ADMIN = "true"
YOUTUBE_AUTHORIZED_URI = "https://premium-web-app-arjuntewari0505.replit.app/api/auth/youtube/callback"
NODE_OPTIONS = "--use-openssl-ca"

[nix]
channel = "stable-24_11"
