# Emerald AI — AQ Intelligence Platform
# Copy to .env and fill in your keys

# Required
SERPER_KEY=         # Serper.dev news search API key
CLAUDE_KEY=         # Anthropic Claude API key

# Optional — AEO (LLM visibility module)
OPENAI_KEY=         # OpenAI API key
PERPLEXITY_KEY=     # Perplexity API key
GEMINI_KEY=         # Google Gemini API key

# Optional — Social ER module (Apify)
APIFY_TOKEN=        # Get from apify.com → Settings → Integrations

# Auth
JWT_SECRET=         # Random secret for JWT signing
ADMIN_INITIAL_PASSWORD=  # Initial password for the admin account
SEED_ADMIN=true     # Set to true to seed admin user on first boot
